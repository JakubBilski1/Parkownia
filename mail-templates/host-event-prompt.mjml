<mjml>
  <mj-head>
    <mj-title>ParkSpot</mj-title>
    <mj-preview>{{eventTitle}}, {{eventDay}}. Z Twojego parkingu {{walkDistance}}.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'IBM Plex Sans', -apple-system, 'Segoe UI', Roboto, Arial, sans-serif" />
      <mj-text color="#191A1C" font-size="16px" line-height="24px" padding="0 0 16px" />
    </mj-attributes>
    <mj-style>
      .muted div { color:#70747A !important; font-size:14px !important; line-height:20px !important; }
      .mono div  { font-family:'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace !important; }
      a { color:#8E2B2B; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#EEEEEB" width="560px">
    <mj-wrapper background-color="#FFFFFF" border="1px solid #DEDEDA" border-radius="14px" padding="32px 28px">
      <mj-section padding="0">
        <mj-column>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="18px" font-weight="800" letter-spacing="-0.01em" padding="0 0 24px">ParkSpot</mj-text>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="28px" font-weight="700" line-height="34px" letter-spacing="-0.02em" padding="0 0 16px">Twój parking stoi pusty</mj-text>
          <mj-text padding="0 0 16px">{{#if firstName}}{{firstName}}, w {{else}}W {{/if}}{{eventDay}} o {{eventTime}} na obiekcie {{venueName}} odbywa się {{eventTitle}}. Z Twojego parkingu {{parkingTitle}} jest tam {{walkDistance}}. Tego dnia kierowcy będą krążyć w okolicy i szukać miejsca.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#F3F3F0" border="1px solid #DEDEDA" border-radius="14px" padding="20px">
        <mj-column>
          <mj-text css-class="muted" padding="0 0 2px">Proponujemy</mj-text>
          <mj-text padding="0 0 14px">{{suggestion}}</mj-text>
          <mj-text css-class="muted" padding="0 0 2px">Dostaniesz na konto</mj-text>
          <mj-text css-class="mono" padding="0 0 14px">{{payout}}</mj-text>
          <mj-text css-class="muted" padding="0">Kwota po naszej prowizji, przy komplecie sprzedanych miejsc. Liczbę miejsc i cenę zmienisz na stronie.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-button href="{{shareUrl}}" background-color="#8E2B2B" color="#FFFFFF" border-radius="12px" font-size="16px" font-weight="600" align="left" inner-padding="12px 24px" padding="0 0 20px">Udostępnij miejsca</mj-button>
          <mj-text padding="0 0 20px"><a href="{{declineUrl}}" style="color:#191A1C;text-decoration:underline;">Nie tym razem</a></mj-text>
          <mj-text css-class="muted" padding="0">Link działa bez logowania i tylko dla tego wydarzenia.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-divider border-color="#DEDEDA" border-width="1px" padding="28px 0 20px" />
          <mj-text css-class="muted" padding="0 0 6px">Piszemy do Ciebie, bo masz w ParkSpot parking blisko tego wydarzenia. Jeden e-mail na wydarzenie, nie więcej.</mj-text>
          <mj-text css-class="muted" padding="0"><a href="https://parkspot.pl/konto" style="color:#70747A;">Ustawienia powiadomień</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
