# ParkSpot — environment variables reference.
# Copy to .env.local for local development (never commit .env.local).

# --- Database ---------------------------------------------------------------
# Postgres 16 + PostGIS (extensions: postgis, citext, pgcrypto — all required;
# apply db/extensions.sql once as a superuser). The database is never part of the
# app: bring your own, locally and on the VPS, and point this at it.
# 5432 below is just the Postgres default. The project's own database runs on
# 5433 under WSL, so set this to whatever YOUR Postgres actually listens on.
# See db/README.md.
DATABASE_URL="postgresql://parkspot:parkspot@localhost:5432/parkspot"

# Throwaway database for `npm run test:integration` (tests/README.md). It MUST be
# a different database than DATABASE_URL — the suite writes, deletes, and bulk-
# inserts a few hundred parkings to make the planner commit to the GiST index, and
# global-setup refuses to run if the two point at the same place. Created
# automatically on first run (the role needs CREATEDB); `npm test` never reads it.
TEST_DATABASE_URL="postgresql://parkspot:parkspot@localhost:5432/parkspot_test"

# --- Auth (own JWT, not NextAuth — docs/ARCHITECTURE.md §3) -----------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-random-48-byte-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-48-byte-secret"
# Signs single-use action links (e.g. host availability email, docs/ARCHITECTURE.md §5.3).
ACTION_TOKEN_SECRET="replace-with-a-different-random-48-byte-secret"

# --- Object storage (S3-compatible; MinIO is the usual local stand-in) ------
# Nothing starts MinIO for you — run it yourself if you want it:
#   docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# Without it everything works except parking photo upload.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="parkspot-dev"
S3_ACCESS_KEY="parkspot"
S3_SECRET_KEY="parkspot-dev-secret"
# Public base URL used to build links to uploaded photos (e.g. MinIO console
# public alias, or a CDN URL in prod).
S3_PUBLIC_URL="http://localhost:9000/parkspot-dev"

# --- Payments (docs/PAYMENTS.md) --------------------------------------------
# "mock" bypasses a real PSP for local dev; switch to "stripe" deliberately.
#
# Switching to "stripe" turns on two rules that are OFF under the mock:
#   1. a parking cannot be published until its host has payouts_enabled=true
#      (Stripe Connect onboarding finished) — docs/PAYMENTS.md §2.2
#   2. a booking cannot be paid for if the host cannot receive the money
# Both are deliberate: we do not sell spots we cannot pay the host for.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
# Verifies the webhook signature. Get it from `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=""
# Safe to expose — but it is still served to the browser through the intent
# response, not inlined at build time, so a key rotation needs no rebuild.
STRIPE_PUBLISHABLE_KEY=""

# --- Email -------------------------------------------------------------------
# "console" logs emails to stdout instead of sending — default for local dev.
EMAIL_PROVIDER="console"
SMTP_URL=""
RESEND_API_KEY=""
EMAIL_FROM="ParkSpot <no-reply@parkspot.pl>"

# --- SMS (feature-flagged — docs/RISKS.md R16, cost per SMS) -----------------
SMS_ENABLED="false"
SMSAPI_TOKEN=""
# Sender name shown on the phone. Must be a name pre-registered with SMSAPI;
# an unregistered one is silently rejected by the operator. Defaults to "Info".
SMSAPI_SENDER="ParkSpot"

# --- Geocoding (docs/RISKS.md R13) -------------------------------------------
# "nominatim" for dev only (1 req/s, no production volume allowed).
# Switch to "geoapify" deliberately before any real traffic.
GEOCODER="nominatim"
GEOAPIFY_KEY=""
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# --- Government APIs (docs/RISKS.md R12 — best-effort, never blocking) ------
GUS_API_KEY=""

# --- App ----------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle at build time. In the Docker
# image it is therefore a BUILD ARG, not a runtime env:
#   docker build --build-arg NEXT_PUBLIC_APP_URL=https://parkspot.pl -t parkspot .
# Setting it only at `docker run` is too late — payment returns and e-mail links
# would point at the wrong host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Shared secret for Vercel/OS-level cron calling internal cron endpoints.
CRON_SECRET="replace-with-a-random-secret"

# --- Container startup (read by docker-entrypoint.sh, not by the app) --------
# Only meaningful inside the production image. Locally you run the equivalent
# steps yourself (`npm run db:migrate`, `npm run db:seed`), so these are ignored.
#
# Migrations, applied before the server takes its first request. Leave on unless
# you migrate as a separate step (you must, if you ever run >1 replica).
RUN_MIGRATIONS="true"
#
# Reference data: commission rules (50% private / 30% business), the default
# refund policy, venues and events. On by default because it is not dev noise —
# resolveCommissionRatePct throws when no commission rule matches, so on a
# database with only migrations applied EVERY booking fails.
# The seed is idempotent, but it re-inserts its venues and events on every boot:
# an event deleted in the admin panel comes back on the next restart. Once events
# are managed from the admin panel, set this to false.
RUN_SEED="true"

# --- Seed --------------------------------------------------------------------
# LOCAL ONLY. SEED_DEV=1 adds dev fixtures on top of the reference data (venues,
# events, commission rules): ~20 demo parkings around both venues and one test
# account per role (admin@/host@/firma@/kierowca@parkspot.pl, password
# `parkspot123`). Never set this in production — it creates accounts with known
# passwords, and docker-entrypoint.sh never sets it.
SEED_DEV="1"
