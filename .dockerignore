# Keep the build context small and keep secrets out of the image.

# dependencies (reinstalled inside the image from package-lock.json)
node_modules
.pnp
.pnp.js

# build output
.next
out
build
dist
*.tsbuildinfo

# secrets — never copy these into a layer
.env
.env.local
.env.*.local

# git / CI
.git
.gitignore
.github

# tests and their reports (not shipped, and not needed to build)
tests
playwright.config.ts
playwright-report
test-results
blob-report
coverage
vitest.config.ts

# docs and local infra
docs
db/init
*.md
!README.md
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.dev.yml

# editor / OS
.vscode
.idea
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
