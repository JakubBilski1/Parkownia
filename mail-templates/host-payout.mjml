<mjml>
  <mj-head>
    <mj-title>Parkownia</mj-title>
    <mj-preview>Wypłata {{amount}} za {{periodStart}} – {{periodEnd}}.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'IBM Plex Sans', -apple-system, 'Segoe UI', Roboto, Arial, sans-serif" />
      <mj-text color="#191A1C" font-size="16px" line-height="24px" padding="0 0 16px" />
    </mj-attributes>
    <mj-style>
      .muted div { color:#70747A !important; font-size:14px !important; line-height:20px !important; }
      .mono div  { font-family:'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace !important; }
      a { color:#8E2B2B; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#EEEEEB" width="560px">
    <mj-wrapper background-color="#FFFFFF" border="1px solid #DEDEDA" border-radius="14px" padding="32px 28px">
      <mj-section padding="0">
        <mj-column>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="18px" font-weight="800" letter-spacing="-0.01em" padding="0 0 24px">Parkownia</mj-text>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="28px" font-weight="700" line-height="34px" letter-spacing="-0.02em" padding="0 0 16px">Wysłaliśmy Ci wypłatę</mj-text>
          <mj-text padding="0 0 16px">{{#if firstName}}{{firstName}}, rozliczyliśmy{{else}}Rozliczyliśmy{{/if}} Twoje rezerwacje z okresu {{periodStart}} – {{periodEnd}}.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#F3F3F0" border="1px solid #DEDEDA" border-radius="14px" padding="20px">
        <mj-column>
          <mj-text css-class="muted" padding="0 0 2px">Kwota</mj-text>
          <mj-text css-class="mono" padding="0 0 14px">{{amount}}</mj-text>
          <mj-text css-class="muted" padding="0 0 2px">Rezerwacje</mj-text>
          <mj-text padding="0 0 14px">{{bookings}}</mj-text>
          {{#if accountLast4}}
          <mj-text css-class="muted" padding="0 0 2px">Konto</mj-text>
          <mj-text css-class="mono" padding="0 0 14px">•••• {{accountLast4}}</mj-text>
          {{/if}}
          <mj-text css-class="muted" padding="0">Kwota po naszej prowizji. Przelew idzie zwykle 1–2 dni robocze.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-text padding="0 0 20px"><a href="{{earningsUrl}}" style="color:#191A1C;text-decoration:underline;">Rozliczenie co do rezerwacji</a></mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-divider border-color="#DEDEDA" border-width="1px" padding="28px 0 20px" />
          <mj-text css-class="muted" padding="0 0 6px">Ten e-mail dostajesz, bo udostępniasz parking w Parkownia.</mj-text>
          <mj-text css-class="muted" padding="0"><a href="https://parkownia.com/konto" style="color:#70747A;">Ustawienia powiadomień</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
