<mjml>
  <mj-head>
    <mj-title>ParkSpot</mj-title>
    <mj-preview>Rezerwacja {{code}} anulowana.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'IBM Plex Sans', -apple-system, 'Segoe UI', Roboto, Arial, sans-serif" />
      <mj-text color="#191A1C" font-size="16px" line-height="24px" padding="0 0 16px" />
    </mj-attributes>
    <mj-style>
      .muted div { color:#70747A !important; font-size:14px !important; line-height:20px !important; }
      .mono div  { font-family:'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace !important; }
      a { color:#8E2B2B; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#EEEEEB" width="560px">
    <mj-wrapper background-color="#FFFFFF" border="1px solid #DEDEDA" border-radius="14px" padding="32px 28px">
      <mj-section padding="0">
        <mj-column>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="18px" font-weight="800" letter-spacing="-0.01em" padding="0 0 24px">ParkSpot</mj-text>
          <mj-text font-family="Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="28px" font-weight="700" line-height="34px" letter-spacing="-0.02em" padding="0 0 16px">Rezerwacja anulowana</mj-text>
          <mj-text padding="0 0 16px">{{#if firstName}}{{firstName}}. {{/if}}{{whatHappened}} Miejsce na {{parkingTitle}} o {{startsAt}} nie jest już Twoje.</mj-text>
          {{#if reason}}
          <mj-text padding="0 0 16px">Powód: {{reason}}</mj-text>
          {{/if}}
        </mj-column>
      </mj-section>
      <mj-section background-color="#F3F3F0" border="1px solid #DEDEDA" border-radius="14px" padding="20px">
        <mj-column>
          <mj-text css-class="muted" padding="0 0 2px">Zapłaciłeś</mj-text>
          <mj-text css-class="mono" padding="0 0 14px">{{price}}</mj-text>
          <mj-text css-class="muted" padding="0 0 2px">Zwracamy</mj-text>
          <mj-text css-class="mono" padding="0 0 14px">{{refund}}</mj-text>
          <mj-text css-class="muted" padding="0">{{refundNote}}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          {{#if byHost}}
          <mj-text padding="0 0 16px">Zwrot to za mało, gdy zostajesz bez miejsca na godzinę przed meczem. Sprawdź, co jest wolne w okolicy.</mj-text>
          {{/if}}
          <mj-text padding="0 0 20px"><a href="{{mapUrl}}" style="color:#191A1C;text-decoration:underline;">Znajdź inne miejsce</a></mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-divider border-color="#DEDEDA" border-width="1px" padding="28px 0 20px" />
          <mj-text css-class="muted" padding="0 0 6px">Ten e-mail dostajesz, bo Twoja rezerwacja w ParkSpot została anulowana.</mj-text>
          <mj-text css-class="muted" padding="0"><a href="https://parkspot.pl/konto" style="color:#70747A;">Ustawienia powiadomień</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
