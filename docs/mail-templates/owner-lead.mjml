<!--
  Parkownia — owner-lead

  WKLEJ TO w dashboardzie pbdevs (mail.pbdevs.com, aplikacja Parkownia) jako
  szablon o nazwie „owner-lead”.
  Temat wiadomości ustaw na: {{subject}}
  (treść tematu składa aplikacja, tak samo jak w owner-campaign).

  Alert wewnętrzny: przychodzi na LEAD_ALERT_EMAIL przy każdym zgłoszeniu
  z landingu, nigdy do samego zgłaszającego.

  Zmienne, które wysyła aplikacja (src/modules/leads/notify.ts → data):
    subject, receivedAt, contactName, phone, email, prefersPhone, contactLine,
    objectName, address, objectType, spots, spotsLabel, ownerKind,
    walkEnea, walkMtp, eventsInReach, estimatedRate, estimatedAnnual,
    consentsLine, source, ctaUrl, ctaLabel

  pbdevs wyciąga nazwy zmiennych z CAŁEGO źródła, łącznie z tym komentarzem
  i z warunkami „#if", uznaje każdą za wymaganą i odrzuca wysyłkę (422), gdy
  któraś przyjdzie jako null. Dlatego: aplikacja wysyła "" zamiast null, w tym
  komentarzu nie ma podwójnych klamer poza tematem wyżej, a
  tests/unit/leads/notify.test.ts sprawdza, że każda zmienna z tego pliku
  przychodzi z wartością. Dodajesz zmienną tutaj → dodaj ją w notify.ts.

  Warunki stoją WEWNĄTRZ <mj-text>, nie między komponentami: MJML kompiluje
  się przy zapisie szablonu, a tekst między komponentami nie musi przetrwać
  tej kompilacji. Treść <mj-text> przechodzi bez zmian.

  Kolory jak w owner-campaign.mjml (motyw jasny „Bilet").
-->
<mjml>
  <mj-head>
    <mj-title>Nowe zgłoszenie miejsca</mj-title>
    <mj-preview>{{spotsLabel}} · {{address}} · {{contactLine}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#1a1918" font-size="16px" line-height="1.55" padding="0" />
    </mj-attributes>
    <mj-style>
      a { color: #8e2b2b; }
      .row { padding: 0 0 10px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#eeeeeb" width="600px">
    <mj-section padding="24px 24px 12px">
      <mj-column>
        <mj-text font-size="20px" font-weight="800" letter-spacing="-0.02em">Parkownia</mj-text>
      </mj-column>
    </mj-section>

    <!-- Kto i jak oddzwonić. To ma być widoczne bez przewijania. -->
    <mj-section background-color="#ffffff" border-radius="12px 12px 0 0" padding="28px 24px 8px">
      <mj-column>
        <mj-text font-size="13px" color="#6b6862" text-transform="uppercase" letter-spacing="0.06em" padding="0 0 6px">Nowe zgłoszenie · {{receivedAt}}</mj-text>
        <mj-text font-size="24px" font-weight="800" line-height="1.25" letter-spacing="-0.02em" padding="0 0 14px">
          {{contactName}} — {{spotsLabel}}
        </mj-text>
        <mj-text font-weight="700" padding="0 0 8px">{{contactLine}}</mj-text>
        <mj-text padding="0 0 20px">
          {{#if phone}}<div class="row">Telefon: <a href="tel:{{phone}}">{{phone}}</a></div>{{/if}}
          {{#if email}}<div class="row">E-mail: <a href="mailto:{{email}}">{{email}}</a></div>{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 24px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#dedbd4" padding="0 0 20px" />
        <mj-text font-size="13px" color="#6b6862" text-transform="uppercase" letter-spacing="0.06em" padding="0 0 8px">Miejsce</mj-text>
        <mj-text padding="0 0 20px">
          {{#if objectName}}<div class="row"><strong>{{objectName}}</strong></div>{{/if}}
          <div class="row">{{address}}</div>
          <div class="row">Rodzaj: {{objectType}} · {{spotsLabel}} · {{ownerKind}}</div>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 24px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#dedbd4" padding="0 0 20px" />
        <mj-text font-size="13px" color="#6b6862" text-transform="uppercase" letter-spacing="0.06em" padding="0 0 8px">Szacunek z kalkulatora</mj-text>
        <mj-text padding="0 0 20px">
          {{#if eventsInReach}}
          {{#if walkEnea}}<div class="row">Do Enei: {{walkEnea}} pieszo (szacunek z linii prostej)</div>{{/if}}
          {{#if walkMtp}}<div class="row">Do MTP: {{walkMtp}} pieszo (szacunek z linii prostej)</div>{{/if}}
          <div class="row">Wydarzeń w zasięgu w 12 miesięcy: {{eventsInReach}}</div>
          {{#if estimatedRate}}<div class="row">Stawka: {{estimatedRate}} za miejsce na wydarzenie</div>{{/if}}
          {{#if estimatedAnnual}}<div class="row">Rocznie dla właściciela: {{estimatedAnnual}}</div>{{/if}}
          {{else}}
          <div class="row">Brak — adres nie został wskazany na mapie, więc kalkulator nic nie policzył.</div>
          {{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="0 0 12px 12px" padding="0 24px 28px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#dedbd4" padding="0 0 20px" />
        <mj-text font-size="14px" color="#6b6862" padding="0 0 4px">Zgody marketingowe: {{consentsLine}}</mj-text>
        <mj-text font-size="14px" color="#6b6862" padding="0 0 8px">
          {{#if source}}Źródło: {{source}}{{/if}}
        </mj-text>
        <mj-button
          href="{{ctaUrl}}"
          background-color="#8e2b2b"
          color="#f7f6f3"
          font-size="16px"
          font-weight="700"
          border-radius="10px"
          padding="16px 0 0"
          inner-padding="14px 24px"
          align="left"
        >
          {{ctaLabel}}
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px 32px">
      <mj-column>
        <mj-text font-size="13px" color="#6b6862">
          Alert wewnętrzny Parkowni, wysyłany przy każdym zgłoszeniu z parkownia.com.
          Zawiera dane osobowe zgłaszającego — nie przesyłaj go dalej.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
